// =======================
// PRISMA SETUP
// =======================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =======================
// ENUMS
// =======================

enum Role {
  CUSTOMER
  TAILOR
  SUPPORT
  ADMIN
}

// =======================
// USER & AUTH
// =======================

model User {
  id       String  @id @default(uuid())
  name     String
  email    String  @unique
  password String
  role     Role    @default(CUSTOMER)
  isActive Boolean @default(true)

  // Relations
  profile       UserProfile?
  tailor        Tailor?
  refreshTokens RefreshToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =======================
// USER PROFILE
// =======================

model UserProfile {
  id     String @id @default(uuid())
  userId String @unique

  fullName String
  phone    String
  address  String
  dob      DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =======================
// TAILOR
// =======================

model Tailor {
  id     String @id @default(uuid())
  userId String @unique

  shopName String
  location String
  isActive Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =======================
// AUTH TOKENS
// =======================

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}
